ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Kling AI (kling-o1) for AI-animated scene backgrounds. If unset,
# generate-video.js automatically falls back to the free gradient background
# (lib/background.js) — no error, just lower-fi visuals.
# KLING_API_KEY=your_kling_api_key_here
# KLING_CLIP_DURATION=5

# --- Login + Actions-trigger API (api/login.js, api/trigger-workflow.js, api/workflow-status.js) ---
# Password required to unlock the trigger buttons on the page.
APP_PASSWORD=choose_a_strong_password
# Random secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=generate_a_random_secret_here
# GitHub Personal Access Token with permission to dispatch workflows AND
# commit file edits on this repo (used by api/trigger-workflow.js and
# api/save-scenes.js): classic PAT with "repo" + "workflow" scope, or a
# fine-grained PAT with Actions:write + Contents:read-and-write on
# boryeong26/shortapp. Contents:read-only is NOT enough once scene
# editing (api/save-scenes.js) is in use — it needs write access.
GITHUB_DISPATCH_TOKEN=your_github_pat_here
# Optional overrides:
# GITHUB_REPO=boryeong26/shortapp
# GITHUB_REF=main
# CORS_ORIGIN=https://boryeong26.github.io
