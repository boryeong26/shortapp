ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- API (api/save-sentences.js) ---
# No login/password gate — anyone who can load the page can save/overwrite
# the saved-sentences list.

# GitHub Personal Access Token with permission to commit file edits on
# this repo (used by api/save-sentences.js to persist the saved sentence
# list to data/saved-sentences.json): classic PAT with "repo" scope, or
# a fine-grained PAT with Contents:read-and-write on boryeong26/shortapp.
GITHUB_DISPATCH_TOKEN=your_github_pat_here
# Optional overrides:
# GITHUB_REPO=boryeong26/shortapp
# GITHUB_REF=main
# CORS_ORIGIN=https://boryeong26.github.io

# --- GitHub Actions secrets (separate from the Vercel env vars above) ---
# .github/workflows/daily-pick.yml runs scripts/daily-pick.js once a day
# (07:00 KST) to generate data/daily-paragraph.json + data/daily-paragraph/
# (practice paragraph + per-sentence TTS audio). It needs these registered
# as *repository* secrets (Settings > Secrets and variables > Actions) —
# Vercel's env vars aren't visible to Actions:
# - ANTHROPIC_API_KEY
# - ELEVENLABS_API_KEY
# - ELEVENLABS_VOICE_ID (optional — defaults to a known-working voice
#   on this project's prior ElevenLabs account; set this if that
#   account/voice ever changes)
