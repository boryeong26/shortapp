ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 key (used by lib/youtubeSearch.js to search videos).
# Create one at https://console.cloud.google.com/apis/credentials after
# enabling the "YouTube Data API v3" API on a project.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# --- API (api/search-videos.js, api/save-recommendations.js) ---
# No login/password gate — anyone who can load the page can search
# (consumes YOUTUBE_API_KEY/ANTHROPIC_API_KEY quota) and save the list.

# GitHub Personal Access Token with permission to commit file edits on
# this repo (used by api/save-recommendations.js to persist the saved
# list to data/recommendations.json): classic PAT with "repo" scope, or
# a fine-grained PAT with Contents:read-and-write on boryeong26/shortapp.
GITHUB_DISPATCH_TOKEN=your_github_pat_here
# Optional overrides:
# GITHUB_REPO=boryeong26/shortapp
# GITHUB_REF=main
# CORS_ORIGIN=https://boryeong26.github.io

# --- GitHub Actions secrets (separate from the Vercel env vars above) ---
# .github/workflows/daily-pick.yml runs scripts/daily-pick.js once a day
# (07:00 KST) to generate data/daily.json (video picks) and
# data/daily-paragraph.json + data/daily-paragraph.mp3 (practice
# paragraph + TTS audio). It needs these registered as *repository*
# secrets (Settings > Secrets and variables > Actions) — Vercel's env
# vars aren't visible to Actions:
# - ANTHROPIC_API_KEY
# - YOUTUBE_API_KEY
# - ELEVENLABS_API_KEY
# - ELEVENLABS_VOICE_ID (optional — defaults to a known-working voice
#   on this project's prior ElevenLabs account; set this if that
#   account/voice ever changes)
