ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 key (used by lib/youtubeSearch.js to search videos).
# Create one at https://console.cloud.google.com/apis/credentials after
# enabling the "YouTube Data API v3" API on a project.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# --- Login + API (api/login.js, api/search-videos.js, api/save-recommendations.js) ---
# Password required to unlock search/save on the page.
APP_PASSWORD=choose_a_strong_password
# Random secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=generate_a_random_secret_here
# GitHub Personal Access Token with permission to commit file edits on
# this repo (used by api/save-recommendations.js to persist the saved
# list to data/recommendations.json): classic PAT with "repo" scope, or
# a fine-grained PAT with Contents:read-and-write on boryeong26/shortapp.
GITHUB_DISPATCH_TOKEN=your_github_pat_here
# Optional overrides:
# GITHUB_REPO=boryeong26/shortapp
# GITHUB_REF=main
# CORS_ORIGIN=https://boryeong26.github.io
